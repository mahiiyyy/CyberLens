PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberlens
# Generate a unique random secret of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional VirusTotal API key for URL/domain/IP reputation enrichment
VIRUSTOTAL_API_KEY=

# Optional ClamAV daemon for attachment scanning (leave unset to report SCAN_UNAVAILABLE)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
