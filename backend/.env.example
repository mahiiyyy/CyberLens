PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberlens
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# --- Optional integrations (features degrade honestly when unset) ---
# Reputation lookups (server-side only; keys are never sent to the browser).
# Free tiers are rate limited; CyberLens caps lookups at 30/hour per account.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# Evidence-grounded AI summaries (Anthropic API). Only numbered evidence facts are sent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local FastAPI text-heuristic service (see ai-service/)
AI_SERVICE_URL=http://127.0.0.1:8000
